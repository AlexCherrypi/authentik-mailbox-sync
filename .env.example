# Secrets — generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SYNC_WEBHOOK_SECRET=
SYNC_ADMIN_TOKEN=

# Mailcow
# Internal hostname or external URL that resolves to nginx-mailcow.
MAILCOW_API=http://nginx-mailcow
# Read-write API key from Mailcow Admin UI → Access → API
MAILCOW_API_KEY=

# Mailcow MariaDB (needed for SOGo delegation writes — sogo-tool is broken in
# Mailcow's container layout, see mailcow/mailcow-dockerized#6355).
MAILCOW_DB_HOST=mysql-mailcow
MAILCOW_DB_NAME=mailcow
MAILCOW_DB_USER=mailcow
MAILCOW_DB_PASSWORD=

# Authentik (for the periodic sweep that reconciles every Authentik-known user)
AUTHENTIK_API_URL=
AUTHENTIK_API_TOKEN=

# Service config
# All mailboxes outside this domain are treated as user-owned and left untouched.
OUR_DOMAIN=example.com
# Where the SQLite state DB lives inside the container — bind-mount this from the host.
STATE_DB_PATH=/var/lib/sync/state.db
# Container names for `docker exec` targets (must match your Mailcow/Nextcloud deployment).
DOVECOT_CONTAINER=mailcow-dovecot-mailcow-1
MEMCACHED_CONTAINER=mailcow-memcached-mailcow-1
NEXTCLOUD_CONTAINER=nextcloud
LOG_LEVEL=info

# Nextcloud Mail database (Postgres) — used to provision ManageSieve settings
# and repair the special-folder mapping directly in oc_mail_accounts /
# oc_mail_mailboxes (occ has no command for either). AMS runs `docker exec
# <NC_DB_CONTAINER> psql -U <NC_DB_USER> -d <NC_DB_NAME>`; the DB container
# authenticates the local psql client over its Unix socket, so no password is
# needed here.
NC_DB_CONTAINER=nextcloud-aio-database
NC_DB_NAME=nextcloud_database
NC_DB_USER=nextcloud

# ManageSieve provisioning (Feature: NC Mail server-side filters).
# When "true", each managed NC-Mail account gets sieve_enabled=true pointing at
# the coordinates below, and its Sent/Drafts/Trash mapping is repaired to the
# local folders. sieve_user/sieve_password stay NULL on purpose — NC Mail 5.x
# then reuses the account's encrypted IMAP credentials for the Sieve login.
# Keep this OFF until the ManageSieve port (default 4190) is actually reachable,
# otherwise NC shows a broken filter tab. SIEVE_HOST defaults to IMAP_HOST.
SIEVE_PROVISIONING=false
SIEVE_HOST=
SIEVE_PORT=4190
SIEVE_SSL_MODE=tls

# Nextcloud Mail account coords — these go into each NC-Mail account config so
# end-user clients can reach the IMAP/SMTP server. Must be the publicly resolvable
# Mailcow hostname.
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl

# Safety net — when "true", the service computes the diff and returns what
# it WOULD change, but does not touch Mailcow or Nextcloud. Recommended ON
# until you've verified the reconcile shape for a few real users.
SYNC_DRY_RUN=true

# --- Thunderbird setup tool: GET /my-accounts (T-009d) ---------------------
# OIDC-authenticated per-user endpoint that mints fresh tb-setup App-Passwords
# and returns IMAP/SMTP coords + salutation templates. Off by default.
#
# When "true", the endpoint is served; when the tb-setup revocation runs in the
# sweep, it is ALSO gated on this same flag, so a deploy with the flag off is a
# strict no-op for tb-setup rows.
MY_ACCOUNTS_ENABLED=false

# OIDC validator for /my-accounts. All three must be set or the endpoint fails
# closed with 503. Validation is local against the provider's JWKS (RS256).
#   OIDC_ISSUER   — the token's expected `iss` (trailing slash as issued)
#   OIDC_JWKS_URL — Authentik pattern: .../application/o/<slug>/jwks/
#   OIDC_AUDIENCE — client_id of the dedicated "mail-setup" OAuth2 provider, so
#                   a token minted for any OTHER application is rejected here.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
# Escape hatch for local dev only — "false"/"0"/"no"/"off" disables signature
# + claim verification. NEVER set this in production. Defaults to full verify.
OIDC_VERIFY=

# Salutation/signature templates (D-007). JSON file mounted as a volume and
# read fresh on every /my-accounts request, so wording changes need neither a
# tool update nor an AMS rebuild. See signatures.example.json for the schema.
SIGNATURES_CONFIG_PATH=/config/signatures.json
